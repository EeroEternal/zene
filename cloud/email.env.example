# Copy to email.env. Used by cloud/scripts/dev.sh.

# Cloudflare Email Sending (Recommended)
export CLOUDFLARE_MAIL_TOKEN=cf_...
export CLOUDFLARE_ACCOUNT_ID=...
export CLOUDFLARE_EMAIL_FROM="Zene <noreply@zene.run>"

# Resend Email (Fallback / Legacy)
# export RESEND_API_KEY=re_...
# export RESEND_FROM="Zene <noreply@zene.run>"
