# Copy to /etc/zene-cloud.env on the VM (chmod 600).

ZENE_CLOUD_BIND=127.0.0.1:8788
ZENE_CLOUD_DATABASE_URL=sqlite:/var/lib/zene-cloud/zene-cloud.db
ZENE_CLOUD_WORKER_TOKEN=change-me-to-a-long-random-token
ZENE_CLOUD_WEB_DIR=/opt/zene-cloud/web
ZENE_CLOUD_WORKSPACE_ROOT=/var/lib/zene-cloud/workspaces
ZENE_CLOUD_API_URL=http://127.0.0.1:8788
ZENE_CLOUD_PUBLIC_BASE_URL=https://zene.run
ZENE_CLOUD_GITHUB_MODE=live
ZENE_CLOUD_PUSH_PR=true
ZENE_CLOUD_ACP_YOLO=true
ZENE_BIN=/opt/zene-cloud/bin/zene

# Worker supervisor pool (warm claimers + scale on queue; holds do not consume active slots)
ZENE_CLOUD_WORKER_MIN_WARM=1
ZENE_CLOUD_WORKER_MAX_ACTIVE=4
ZENE_CLOUD_WORKER_MAX_HOLD=8
ZENE_CLOUD_WORKER_SCALE_INTERVAL_MS=1000

# LLM for real ACP runs
# ZENE_API_KEY=
# ZENE_BASE_URL=
# ZENE_MODEL=

# GitHub App (live mode)
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY_PATH=/etc/zene-cloud/github-app.pem
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
