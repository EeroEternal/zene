[Unit]
Description=Zene Inference Gateway (session prefix + upstream proxy)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=zene
Group=zene
EnvironmentFile=/etc/zene-cloud.env
WorkingDirectory=/var/lib/zene-cloud
ExecStart=/opt/zene-cloud/bin/zene-inference-gateway
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
