[Unit]
Description=Zene Cloud API
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=zene
Group=zene
EnvironmentFile=/etc/zene-cloud.env
WorkingDirectory=/var/lib/zene-cloud
ExecStart=/opt/zene-cloud/bin/zene-cloud-api
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
