# Copy to github.env and set your private key path after generating on GitHub.
# GitHub → Settings → Developer settings → GitHub Apps → Zene Cloud Dev → Generate a private key

export GITHUB_APP_ID=4361175
export GITHUB_APP_SLUG=zene-cloud-dev
export GITHUB_APP_PRIVATE_KEY_PATH="$HOME/.zene/github-app.pem"

# Optional OAuth (Connect flow uses GitHub App install only)
# export GITHUB_CLIENT_ID=
# export GITHUB_CLIENT_SECRET=

# Email sign-in (Resend). Without RESEND_API_KEY, the landing page shows the link locally.
# export RESEND_API_KEY=re_...
# export RESEND_FROM="Zene <noreply@zene.run>"
