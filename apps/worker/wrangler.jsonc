{
  "name": "zene-agent-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_GATEWAY_URL": ""
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": ""
    }
  ],
  "migrations": [
    {
      "tag": "001_create_sessions",
      "new_sqlite_classes": ["SessionsDO"]
    }
  ]
}
